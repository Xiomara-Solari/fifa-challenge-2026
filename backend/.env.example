# Configuración de Base de Datos
# En desarrollo local usa localhost; Docker Compose lo sobrescribe a mysql_db en red interna
DB_HOST=localhost
DB_PORT=3306
DB_NAME=football_db
DB_USER=fifa_user
DB_PASSWORD=changeme_db_password
MYSQL_ROOT_PASSWORD=changeme_root_password

# Autenticación JWT
JWT_SECRET=changeme_super_secret_jwt_key
JWT_EXPIRES_IN=24h

# IA Generativa (Google Gemini / LangChain)
GEMINI_API_KEY=your_gemini_api_key_here
